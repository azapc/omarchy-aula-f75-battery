{
  "schemaVersion": 1,
  "id": "io.github.azapc.aula-f75-battery",
  "name": "AULA F75 Battery",
  "version": "0.1.0",
  "author": "azapc",
  "license": "MIT",
  "description": "Battery level for the AULA F75 keyboard in the Omarchy bar, read straight off the Compx 2.4G receiver over raw HID.",
  "kinds": ["bar-widget", "service"],
  "entryPoints": {
    "barWidget": "src/Widget.qml",
    "service": "src/BatteryService.qml"
  },
  "barWidget": {
    "displayName": "AULA F75 Battery",
    "description": "Keyboard battery from the Compx 2.4G receiver",
    "category": "Hardware",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "showPercentage": true,
      "lowThreshold": 20,
      "notifyOnLow": true,
      "pollSeconds": 30
    },
    "schema": [
      {"key": "showPercentage", "type": "boolean", "label": "Show percentage next to the icon"},
      {"key": "lowThreshold", "type": "integer", "min": 5, "max": 50, "label": "Warning battery %"},
      {"key": "notifyOnLow", "type": "boolean", "label": "Notify on low battery"},
      {"key": "pollSeconds", "type": "integer", "min": 5, "max": 3600, "label": "Poll interval (seconds)"}
    ]
  }
}
